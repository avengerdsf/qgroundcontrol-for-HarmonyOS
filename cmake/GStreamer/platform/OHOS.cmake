# OHOS consumes a cross-compiled static SDK; host pkg-config modules must stay invisible.
function(gstreamer_validate_ohos_flags)
    cmake_parse_arguments(ARG "" "KIND" "OPTIONS" ${ARGN})
    foreach(_option IN LISTS ARG_OPTIONS)
        if(_option STREQUAL "-pthread")
            continue()
        endif()
        if(ARG_KIND STREQUAL "COMPILE" AND _option MATCHES "^-D[A-Za-z_][A-Za-z_0-9]*(=[A-Za-z_0-9]+)?$")
            continue()
        endif()
        if(ARG_KIND STREQUAL "LINK" AND _option STREQUAL "-Wl,--export-dynamic")
            continue()
        endif()
        message(FATAL_ERROR "GStreamer: unsupported OHOS pkg-config ${ARG_KIND} option '${_option}'")
    endforeach()
endfunction()

function(gstreamer_validate_ohos_sdk_path PATH)
    if(IS_ABSOLUTE "${PATH}")
        file(REAL_PATH "${PATH}" _candidate)
        if(CMAKE_HOST_WIN32)
            string(TOLOWER "${_candidate}" _candidate)
        endif()
        foreach(_root IN ITEMS "${GStreamer_ROOT_DIR}" "${CMAKE_SYSROOT}")
            if(NOT _root)
                continue()
            endif()
            file(REAL_PATH "${_root}" _prefix)
            if(CMAKE_HOST_WIN32)
                string(TOLOWER "${_prefix}" _prefix)
            endif()
            cmake_path(IS_PREFIX _prefix "${_candidate}" NORMALIZE _inside)
            if(_inside)
                return()
            endif()
        endforeach()
    endif()
    message(FATAL_ERROR "GStreamer OHOS: path outside target SDK and sysroot: ${PATH}")
endfunction()

function(gstreamer_validate_ohos_target TARGET_NAME)
    foreach(_property IN ITEMS INTERFACE_INCLUDE_DIRECTORIES INTERFACE_SYSTEM_INCLUDE_DIRECTORIES INTERFACE_LINK_DIRECTORIES)
        get_target_property(_paths "${TARGET_NAME}" "${_property}")
        if(_paths)
            foreach(_path IN LISTS _paths)
                gstreamer_validate_ohos_sdk_path("${_path}")
            endforeach()
        endif()
    endforeach()
    foreach(_kind IN ITEMS COMPILE LINK)
        get_target_property(_options "${TARGET_NAME}" "INTERFACE_${_kind}_OPTIONS")
        if(_options)
            gstreamer_validate_ohos_flags(KIND "${_kind}" OPTIONS ${_options})
        endif()
    endforeach()
    get_target_property(_libraries "${TARGET_NAME}" INTERFACE_LINK_LIBRARIES)
    if(_libraries)
        foreach(_library IN LISTS _libraries)
            if(TARGET "${_library}" OR _library IN_LIST _gst_IGNORED_SYSTEM_LIBRARIES
               OR _library MATCHES "^-Wl,--exclude-libs,[A-Za-z_0-9.+-]+\\.a$")
                continue()
            endif()
            gstreamer_validate_ohos_sdk_path("${_library}")
        endforeach()
    endif()
endfunction()

macro(_qgc_discover_ohos_sdk)
    if(NOT GStreamer_ROOT_DIR OR NOT IS_DIRECTORY "${GStreamer_ROOT_DIR}")
        message(FATAL_ERROR "GStreamer OHOS: set GStreamer_ROOT_DIR to the target architecture's static SDK prefix")
    endif()
    if(DEFINED GStreamer_USE_STATIC_LIBS AND NOT GStreamer_USE_STATIC_LIBS)
        message(FATAL_ERROR "GStreamer OHOS requires GStreamer_USE_STATIC_LIBS=ON")
    endif()
    if(GStreamer_USE_FRAMEWORK OR GStreamer_USE_XCFRAMEWORK)
        message(FATAL_ERROR "GStreamer OHOS does not support Apple framework SDK layouts")
    endif()
    set(GStreamer_USE_STATIC_LIBS ON)
    set(_gst_ohos_manifest_path "${GStreamer_ROOT_DIR}/build-manifest.json")
    if(NOT EXISTS "${_gst_ohos_manifest_path}")
        message(FATAL_ERROR "GStreamer OHOS: target SDK manifest missing: ${_gst_ohos_manifest_path}")
    endif()
    file(READ "${_gst_ohos_manifest_path}" _gst_ohos_manifest)
    string(JSON _gst_ohos_abi GET "${_gst_ohos_manifest}" abi)
    string(JSON _gst_ohos_library GET "${_gst_ohos_manifest}" defaultLibrary)
    string(JSON _gst_ohos_gl GET "${_gst_ohos_manifest}" glEnabled)
    string(JSON _gst_ohos_version GET "${_gst_ohos_manifest}" version)
    if(OHOS_ARCH AND NOT OHOS_ARCH STREQUAL _gst_ohos_abi)
        message(FATAL_ERROR "GStreamer OHOS: SDK ABI ${_gst_ohos_abi} does not match target ${OHOS_ARCH}")
    endif()
    if(NOT _gst_ohos_library STREQUAL "static")
        message(FATAL_ERROR "GStreamer OHOS: SDK manifest must declare defaultLibrary=static")
    endif()
    if(GStreamer_FIND_VERSION AND _gst_ohos_version VERSION_LESS GStreamer_FIND_VERSION)
        message(FATAL_ERROR "GStreamer OHOS: SDK ${_gst_ohos_version} is older than ${GStreamer_FIND_VERSION}")
    endif()
    option(QGC_GST_OHOS_GL "Enable GStreamer EGL/GLMemory on HarmonyOS" ${_gst_ohos_gl})
    if(QGC_GST_OHOS_GL AND NOT _gst_ohos_gl)
        message(FATAL_ERROR "GStreamer OHOS: GL requested but SDK manifest declares glEnabled=false")
    endif()
    _qgc_json_array_to_list(GSTREAMER_OHOS_MANIFEST_PLUGINS "${_gst_ohos_manifest}" plugins)
    _qgc_json_array_to_list(GSTREAMER_OHOS_GIO_MODULES "${_gst_ohos_manifest}" gioModules)
    if(NOT "openssl" IN_LIST GSTREAMER_OHOS_GIO_MODULES)
        message(FATAL_ERROR "GStreamer OHOS: SDK must provide the static openssl GIO TLS module")
    endif()
    string(JSON _gst_ohos_ca GET "${_gst_ohos_manifest}" caBundle)
    set(GStreamer_OHOS_CA_BUNDLE
        "${GStreamer_ROOT_DIR}/${_gst_ohos_ca}"
        CACHE FILEPATH "CA certificate bundle embedded in the HarmonyOS app"
    )
    if(NOT EXISTS "${GStreamer_OHOS_CA_BUNDLE}")
        message(FATAL_ERROR "GStreamer OHOS: CA bundle not found: ${GStreamer_OHOS_CA_BUNDLE}")
    endif()
    gstreamer_create_layout_target(SDK_ROOT "${GStreamer_ROOT_DIR}" TYPE FLAT)
    set(PKG_CONFIG_USE_CMAKE_PREFIX_PATH FALSE)
    gstreamer_apply_pkgconfig_env(
        MODE
        SDK
        DONT_DEFINE_PREFIX
        LIBDIR
        "${GSTREAMER_LIB_PATH}/pkgconfig"
        "${GSTREAMER_PLUGIN_PATH}/pkgconfig"
        "${GStreamer_ROOT_DIR}/share/pkgconfig"
    )
endmacro()
