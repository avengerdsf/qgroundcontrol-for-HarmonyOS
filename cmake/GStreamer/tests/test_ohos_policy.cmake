cmake_minimum_required(VERSION 3.22)
include("${CMAKE_CURRENT_LIST_DIR}/_assert.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../Json.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../PluginPolicy.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../Components.cmake")

set(QGC_PLATFORM_OHOS TRUE)
set(WIN32 FALSE)
set(LINUX FALSE)
set(ANDROID FALSE)
set(APPLE FALSE)
gstreamer_current_platform_key(_platform)
qgc_test_assert_streq("OHOS selects its own plugin policy" ohos "${_platform}")

file(READ "${CMAKE_CURRENT_LIST_DIR}/../../../.github/build-config.json" QGC_BUILD_CONFIG_CONTENT)
set(QGC_GST_OHOS_GL ON)
set(QGC_BUILD_TESTING ON)
gstreamer_plugins_for(PLATFORM ohos OUT_VAR _plugins)
foreach(_plugin IN ITEMS opengl openh264 vpx libav videotestsrc)
    qgc_test_assert_in_list("OHOS preserves codec and test-source capabilities" "${_plugin}" _plugins)
endforeach()
gstreamer_build_apis_and_deps(_apis _deps Core App)
qgc_test_assert_in_list("GL enabled API" api_gl _apis)

set(QGC_GST_OHOS_GL OFF)
gstreamer_plugins_for(PLATFORM ohos OUT_VAR _cpu_plugins)
qgc_test_assert_not_in_list("explicit CPU profile needs no GL plugin" opengl _cpu_plugins)
gstreamer_build_apis_and_deps(_cpu_apis _cpu_deps Core App)
qgc_test_assert_not_in_list("CPU profile needs no GL API" api_gl _cpu_apis)
qgc_test_assert_not_in_list("CPU profile needs no GL prototypes" api_gl_prototypes _cpu_apis)
gstreamer_runtime_required_plugins(_required)
qgc_test_assert_not_in_list("CPU runtime validation needs no GL plugin" opengl _required)
qgc_test_assert_in_list("CPU profile retains H264 codec" openh264 _cpu_plugins)
qgc_test_assert_in_list("CPU profile retains VP8/VP9 codec" vpx _cpu_plugins)
qgc_test_pass("OHOS GL and explicit CPU policies")
