cmake_minimum_required(VERSION 3.25)

set(CMAKE_SYSTEM_NAME OHOS)
set(OHOS_ARCH arm64-v8a)
set(CMAKE_PROJECT_NAME QGroundControl)
set(QGC_APP_NAME QGroundControl)
set(QGC_ORG_NAME QGroundControl)
set(QGC_PACKAGE_NAME org.mavlink.qgroundcontrol)
set(PROJECT_VERSION 5.1.5)
set(PROJECT_VERSION_MAJOR 5)
set(PROJECT_VERSION_MINOR 1)
set(PROJECT_VERSION_PATCH 5)

# Capture the target API boundary while executing the production CMake file.
function(set_target_properties target properties)
    if(NOT target STREQUAL "QGroundControl" OR NOT properties STREQUAL "PROPERTIES")
        message(FATAL_ERROR "Unexpected HarmonyOS target")
    endif()
    set(_index 2)
    while(_index LESS ARGC)
        set(_key "${ARGV${_index}}")
        math(EXPR _index "${_index} + 1")
        set_property(GLOBAL PROPERTY "captured_${_key}" "${ARGV${_index}}")
        math(EXPR _index "${_index} + 1")
    endwhile()
endfunction()

function(find_package package)
    if(NOT package STREQUAL "Qt6" OR NOT "HarmonyExtrasPrivate" IN_LIST ARGN)
        message(FATAL_ERROR "Unexpected shared Qt dependency")
    endif()
endfunction()

function(target_link_libraries target scope library)
    if(NOT target STREQUAL "QGroundControl" OR NOT scope STREQUAL "PRIVATE" OR
            NOT library STREQUAL "Qt6::HarmonyExtrasPrivate")
        message(FATAL_ERROR "Unexpected shared HarmonyOS linkage")
    endif()
endfunction()

function(target_compile_definitions target scope)
    set_property(GLOBAL APPEND PROPERTY captured_definitions ${ARGN})
endfunction()

function(qt_add_harmonyos_permission target)
    cmake_parse_arguments(PERMISSION "" "NAME" "" ${ARGN})
    set_property(GLOBAL APPEND PROPERTY captured_permissions "${PERMISSION_NAME}")
endfunction()

function(expect_property name expected)
    get_property(_actual GLOBAL PROPERTY "captured_${name}")
    if(NOT "${_actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "${name}: expected '${expected}', got '${_actual}'")
    endif()
endfunction()

include("${SOURCE_ROOT}/cmake/platform/HarmonyOS.cmake")
expect_property(QT_HARMONYOS_MODULE_DEVICE_TYPES "phone;tablet;2in1")
expect_property(QT_HARMONYOS_APP_BUNDLE_NAME "org.mavlink.qgroundcontrol")
expect_property(QT_HARMONYOS_APP_NAME "QGroundControl")
expect_property(QT_HARMONYOS_APP_LABEL "QGroundControl")
expect_property(QT_HARMONYOS_APP_VERSION_NAME "5.1.5")
expect_property(QT_HARMONYOS_APP_VERSION_CODE "5011501")
expect_property(QT_HARMONYOS_TARGET_ARCHS "arm64-v8a")
expect_property(QT_HARMONYOS_ABILITY_ORIENTATION "")
get_property(_permissions GLOBAL PROPERTY captured_permissions)
if(NOT "ohos.permission.ACCESS_BLUETOOTH" IN_LIST _permissions)
    message(FATAL_ERROR "The default Bluetooth module requires ACCESS_BLUETOOTH")
endif()
get_property(_definitions GLOBAL PROPERTY captured_definitions)
if("QGC_HARMONYOS_PHONE" IN_LIST _definitions)
    message(FATAL_ERROR "Unified HAP acquired a phone compile mode")
endif()
foreach(_system Android iOS)
    set(CMAKE_SYSTEM_NAME "${_system}")
    set(QGC_QT_MINIMUM_VERSION 6.8.3)
    set(QGC_QT_MAXIMUM_VERSION 6.8.3)
    include("${SOURCE_ROOT}/cmake/HarmonyOSConfig.cmake")
    if(QGC_PLATFORM_OHOS OR NOT QGC_QT_MINIMUM_VERSION STREQUAL "6.8.3" OR
            NOT QGC_QT_MAXIMUM_VERSION STREQUAL "6.8.3")
        message(FATAL_ERROR "HarmonyOS configuration changed ${_system} behavior")
    endif()
endforeach()
message(STATUS "Unified HarmonyOS device metadata passed")
