+std::optional<QOhosWindowProxy::WindowStatusType> QOhosWindowProxy::tryGetWindowStatus() const
+{
+    return QtOhos::evalInJsThread(
+        [&](QtOhos::JsState &jsState) -> std::optional<WindowStatusType> {
+            if (m_jsScopeData->isWindowClosing())
+                return {};
+            try {
+                return jsState.tryMapOhosEnumFromJs<WindowStatusType>(
+                    m_jsScopeData->jsWindowRef->eval<QNapi::Number>("getWindowStatus()"));
+            } catch (const Napi::Error &error) {
+                qCWarning(QtForOhos, "%s: %s", Q_FUNC_INFO, error.what());
+                return {};
+            }
+        },
+        Q_FUNC_INFO);
+}
